# Copy this file to .env and replace values for your environment.

BASE_DOMAIN=home.example.com # ALLOWED_CHALLENGE_NAME worker secret would be `_acme-challenge.home`

# Cloudflare API configuration for TLS challenge
CLOUDFLARE_API_URL=https://acme-dns-proxy-worker.YOUR_WORKER_SUBDOMAIN.workers.dev/client/v4
CLOUDFLARE_API_TOKEN=YOUR_PROXY_SECRET # token is for proxy worker, not your real Cloudflare API token
